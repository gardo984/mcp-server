# devops_server MCP — copy to .env (git-ignored) and adjust.
# Every value below is also a built-in default; the .env file is optional.

# Transport: "stdio" (local agents, default) or "http".
MCP_TRANSPORT=stdio

# Listen address, only used when MCP_TRANSPORT=http.
MCP_ADDR=:8000

# Root of the AI framework repository this server exposes. Agents are read
# from .github/agents/<name>.agent.md (falling back to agents/<name>.md),
# prompts from .github/prompts/, skills from <name>/SKILL.md directories under
# .github/skills/, skills/ or */skills/, and memories from .github/memories/,
# memories/ or */memories/. Defaults to ./docs, the symlink inside this module
# that points at the framework's .github checkout. A leading "~" is expanded to
# the home directory.
FRAMEWORK_ROOT=./docs

# Log level: debug | info | warn | error. Logs always go to stderr so they
# never corrupt the stdio transport.
LOG_LEVEL=info
